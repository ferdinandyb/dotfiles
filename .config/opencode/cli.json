{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "dracula"
  },
  "animations": true,
  "prompt": {
    "paste": "full"
  },
  "session": {
    "sidebar": "auto",
    "thinking": "hide",
    "scrollbar": false
  },
  "keybinds": {
    "leader": "ctrl+x",
    "agent.cycle": "tab",
    "agent.cycle.reverse": "shift+tab",
    "input.newline": "ctrl+enter",
    "prompt.editor": "<leader>v",
    "model.dialog.favorite": "<leader>f",
    "model.cycle_favorite": "ctrl+f",
    "model.cycle_favorite_reverse": "ctrl+shift+f"
  },
  "diffs": {
    "view": "unified",
    "wrap": "word"
  },
  "attention": {
    "sound": false
  },
  "plugins": [
    "./cli-plugins/tmux-title"
  ]
}
